# Copy to .env. Supply credentials privately; never commit a populated copy.
# See README.md and docs/REVIEW.md before deploying.

# Application and database
NODE_ENV=development
ENVIRONMENT=development
PORT=4001
MONGODB_URI=mongodb://127.0.0.1:27017/jackson-app
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_CLIENT_URL=http://localhost:3000
IMAGE_BASE_URL=http://localhost:4001
ADMIN_API_BASE_URL=http://localhost:4001/api
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=10

# Google and Facebook OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4001/api/auth/facebook/callback
IOS_AUTH_URL_SCHEME=jacksonrewards

# Payments and payouts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_PAY_CLIENT_ID=
TREMENDOUS_API_KEY=
TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2
APP_STORE_SHARED_SECRET=
APP_BUNDLE_ID=com.jackson.rewards.app
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_KEY_FILE=

# Firebase and Android integrity
# Service account values are private. JSON values must be on one line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT=
ANDROID_PACKAGE_NAME=
EXPECTED_CERT_DIGESTS=
INTEGRITY_NONCE_TTL_SECONDS=300
INTEGRITY_TEST_TOKEN=

# Email, SMS, and anti-abuse services
EMAIL=
EMAIL_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VERISOUL_API_KEY=
VERISOUL_BASE_URL=

# Offer providers
BESITOS_BASE_URL=https://api.besitos.ai
BESITOS_PARTNER_ID=
BESITOS_API_TOKEN=
BESITOS_WEBHOOK_SECRET=
BITLABS_BASE_URL=https://api.bitlabs.ai
BITLABS_API_TOKEN=
BITLABS_SECRET_KEY=
BITLABS_SERVER_TO_SERVER_KEY=
BITLABS_REFRESH_INTERVAL_MINUTES=5
BITLABS_WHITELISTED_IP=127.0.0.1
EVERFLOW_BASE_URL=https://api.eflow.team
EVERFLOW_API_KEY=
EVERFLOW_WEBHOOK_SECRET=
AFFISE_BASE_URL=
AFFISE_API_VERSION=3.0
AFFISE_API_KEY=
AFFISE_DEBUG=false
APPLOVIN_MAX_SDK_KEY=

# Attribution
ADJUST_API_TOKEN=
ADJUST_APP_TOKEN=
ADJUST_S2S_SECRET=
OFFERWALL_CAMPAIGNS=
ALLOW_LEVEL_SKIPPING=false
ALLOW_ORGANIC_USERS=false

# Customer support and Cash Coach
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
OPENAI_API_KEY=

# Runtime limits and rewards
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif
VIP_BRONZE_PRICE=4.99
VIP_GOLD_PRICE=9.99
VIP_PLATINUM_PRICE=19.99
MIN_WITHDRAWAL_AMOUNT=20
MAX_WITHDRAWAL_AMOUNT=100
XP_DECAY_DAYS=7
XP_DECAY_PERCENT=0.25

# Observability (optional)
LOG_LEVEL=info
LOG_DIR=./logs
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=jackson-app-backend
GRAFANA_ADMIN_PASSWORD=
