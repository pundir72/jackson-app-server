# Existing environment variables...

# Web app paired with this API. Password-reset emails point here, so each API
# environment must use its matching frontend (local, UAT, or production).
PASSWORD_RESET_CLIENT_URL=http://localhost:3000

# Google Play Integrity API Configuration
# Service account JSON from Google Cloud Console (as a single line JSON string)
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"service-account@your-project.iam.gserviceaccount.com","client_id":"client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-project.iam.gserviceaccount.com"}

# Your Android app's package name (must match exactly with Play Console)
ANDROID_PACKAGE_NAME=com.yourcompany.jacksonapp

# Google Play In-App Purchase (IAP) Configuration
# Service account JSON with Google Play Developer API access (as a single line JSON string)
# This can be the same service account as above if it has both permissions
GOOGLE_PLAY_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"service-account@your-project.iam.gserviceaccount.com","client_id":"client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-project.iam.gserviceaccount.com"}

# Alternative: Path to service account key file (use either this OR GOOGLE_PLAY_SERVICE_ACCOUNT)
# GOOGLE_PLAY_KEY_FILE=/path/to/service-account-key.json
