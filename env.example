# Adjust - S2S API for Event Tracking
# Documentation: https://dev.adjust.com/en/api/s2s-api
# Get API token from: Account Settings > My Profile > API Token
# Get App token from: App Settings in Adjust Dashboard
ADJUST_API_TOKEN=your_adjust_api_token_here
ADJUST_APP_TOKEN=your_adjust_app_token_here

# Adjust S2S V2 - Firebase Configuration (Required for V2)
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate new private key and extract project_id, client_email, private_key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Adjust S2S V2 - Offerwall Campaign Filtering
# Comma-separated list of campaign names that match offerwall promotions
# Example: offerwall_campaign,offerwall_promo,wall_promotion
OFFERWALL_CAMPAIGNS=offerwall_campaign,offerwall_promo

# Adjust S2S V2 - Event Validation Settings (Optional)
ALLOW_LEVEL_SKIPPING=false  # Set to true to allow users to skip levels
ALLOW_ORGANIC_USERS=false    # Set to true to allow organic users (no campaign)

# Tremendous - Global Payouts
