# Database
MONGODB_URI=mongodb://localhost:27017/jackson-app

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Server
PORT=4001
NODE_ENV=development

# Frontend URL (for Socket.io CORS - web testing only)
# Note: Mobile app doesn't need CORS, this is only for web testing interface
FRONTEND_URL=http://localhost:3000

# Mobile App Configuration (Primary - Production)
MOBILE_APP_SCHEME=com.jackson.app
MOBILE_RESET_PASSWORD_PATH=reset-password

# Web Testing URLs (Optional - Testing Only)
WEB_RESET_PASSWORD_URL=https://jacksonrewardsapp.vercel.app/reset-password

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=http://localhost:4001/api/auth/facebook/callback

# Cloudflare Turnstile (Free Plan)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# VIP System
VIP_BRONZE_PRICE=4.99
VIP_GOLD_PRICE=9.99
VIP_PLATINUM_PRICE=19.99

# Cash Coach
MIN_WITHDRAWAL_AMOUNT=20
MAX_WITHDRAWAL_AMOUNT=100

# XP System
XP_DECAY_DAYS=7
XP_DECAY_PERCENT=0.25

# API Integrations
API_BASE_URL=http://localhost:4001

# verisoul.ai - Fraud Prevention
VERISOUL_API_KEY=1uG8YmzSpmszbQf6sGZfMoCvO5DZGH7NWKfX8xgc
VERISOUL_BASE_URL=https://api.sandbox.verisoul.ai

# Bitlabs - Survey Integration
BITLABS_API_KEY=your_bitlabs_api_key_here
BITLABS_PUBLISHER_ID=your_bitlabs_publisher_id_here
BITLABS_BASE_URL=https://api.bitlabs.ai

# Besitos - Game Offers & Surveys Platform
BESITOS_BASE_URL=https://api.besitos.ai
BESITOS_PARTNER_ID=your_besitos_partner_id_here
BESITOS_API_TOKEN=your_besitos_api_token_here

# Tremendous - Global Payouts
TREMENDOUS_API_KEY=your_tremendous_api_key_here
TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2

