{
  "title": "SRE Infrastructure",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["sre", "infra"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Host CPU Usage (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "cpu"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Host Memory Used (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used"
        }
      ],
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Disk Usage / (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
          "legendFormat": "disk"
        }
      ],
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Container CPU (sre_app)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"sre_app\"}[1m]))",
          "legendFormat": "cpu_cores"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Container Memory (sre_app)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=\"sre_app\"}",
          "legendFormat": "memory_bytes"
        }
      ],
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Container Restarts (sre_app)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "changes(container_start_time_seconds{container_label_com_docker_compose_service=\"sre_app\"}[30m])",
          "legendFormat": "restarts"
        }
      ],
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 }
    }
  ]
}
